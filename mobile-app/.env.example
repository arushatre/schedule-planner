# Copy to .env.local (gitignored) and fill in. Expo inlines EXPO_PUBLIC_* values into the app bundle,
# so only put public values here: the project URL and the anon key (RLS protects every table).

# Local stack: run `npx supabase status -o env` in the repo root. Use the laptop's Wi-Fi IP instead of
# 127.0.0.1 so a phone on the same network can reach it, e.g. http://192.168.1.20:54321.
# Hosted: Supabase dashboard → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: the web app's address. "Forgot password?" emails link to its reset page.
EXPO_PUBLIC_WEB_URL=

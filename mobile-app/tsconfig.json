{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["../src/*"],
      // Shared files type-import Supabase; use this app's copy so the client types match.
      "@supabase/supabase-js": ["./node_modules/@supabase/supabase-js"]
    }
  },
  // env.d.ts types import.meta.env, read by ../src/lib/supabase.ts (type-only here, never bundled).
  "include": ["**/*.ts", "**/*.tsx", "../src/env.d.ts"]
}

# Supabase connection for the browser app. Copy to `.env` and fill in.
#
# Local development (`npm run db:start`): run `npx supabase status -o env` and copy
#   API_URL  -> VITE_SUPABASE_URL      (usually http://127.0.0.1:54321)
#   ANON_KEY -> VITE_SUPABASE_ANON_KEY
#
# Hosted project: Project Settings -> API -> Project URL and the anon / publishable key.
#   Apply the schema with `npx supabase link` + `npx supabase db push`, then add the app's
#   origin under Authentication -> URL Configuration (Site URL and Redirect URLs) so magic
#   links and password-reset emails return to it.
#
# Only the public anon/publishable key belongs here. Never put the service_role or
# secret key in any VITE_ variable: everything prefixed VITE_ ships to the browser.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Calendar sync (optional). A Google Cloud OAuth "Web application" client ID;
# see README > Google Calendar. Client IDs are public, so this is safe in a VITE_ variable.
VITE_GOOGLE_CLIENT_ID=
